{
	"name": "meganode",
	"description": "meganode — scale your ideas. Personal site, portfolio and multilingual blog built with Astro and Sveltia CMS.",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"license": "MIT",
	"homepage": "https://github.com/harwellz/astro-sveltia",
	"engines": {
		"node": ">=20.0.0"
	},
	"scripts": {
		"update": "pnpm update",
		"update-interactive": "pnpm update --interactive",
		"dev": "astro dev",
		"start": "astro dev --open",
		"build": "astro check && astro build",
		"preview": "astro preview",
		"check": "astro check && biome check --write .",
		"astro": "astro",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@astrojs/check": "^0.9.6",
		"@astrojs/mdx": "^4.3.13",
		"@astrojs/rss": "^4.0.15",
		"@astrojs/sitemap": "^3.7.0",
		"astro": "^5.17.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.4",
		"sharp": "^0.35.0",
		"typescript": "^5.9.3",
		"vitest": "^4.0.18",
		"wrangler": "^4.141.0"
	},
	"packageManager": "pnpm@10.29.3"
}
